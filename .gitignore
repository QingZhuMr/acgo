# ==================== ThinkPHP 默认 ====================
*.log
.env
composer.phar
.DS_Store
Thumbs.db
/.idea
/.vscode
/vendor
/.settings
/.buildpath
/.project

# ==================== 敏感配置（含密钥，绝不能提交） ====================
.env.production

# ==================== 运行产物 ====================
/runtime
/.user.ini
/tmp
/ws/stubs

# ==================== 用户上传图片（勿入库，仅保留空目录占位） ====================
/public/static/avatar/*
/public/static/post/*
/public/static/comment/*
/public/static/sticker/*

# ==================== WS 运行产物 ====================
/ws/logs
/ws/*.pid
/ws/push.log
/ws/swoole.log
/ws/ws_stdout.log
/ws/ws_stderr.log

# ==================== 编辑器 / AI 工具 ====================
/.hintrc
/.codebuddy

# ==================== 本地脚本运行产物 ====================
# ai_bot.py 建号产生的账号数据（含手机号/密码，勿入库）
/accounts.json
/tools/accounts.json
# Python 缓存
__pycache__/
*.pyc

# ==================== 本地开发工具（不入库，仅本地使用） ====================
# 含服务器凭据等敏感信息的一次性脚本，统一不提交到仓库
/tools/
# 建表/迁移 SQL（本地数据库初始化用，不入库）
/sql/
